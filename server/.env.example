PORT=3000
DB_PATH=./data/fikrnoma.db

# Production uchun majburiy: kamida 32 belgili tasodifiy qator
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# @BotFather'dan olingan bot tokeni (Mini App initData tekshiruvi uchun)
TELEGRAM_BOT_TOKEN=

# Frontend manzili (vergul bilan bir nechta). Lokal ishlab chiqishda * bo'lishi mumkin.
CORS_ORIGIN=*

# Faqat lokal: Telegramsiz kirish (/api/auth/dev). Production'da e'tiborga olinmaydi.
DEV_AUTH=true

# Baza bo'sh bo'lsa namunaviy fikrlar bilan to'ldiradi
SEED=true

# Admin bo'ladigan Telegram ID'lar (vergul bilan)
ADMIN_TELEGRAM_IDS=

# Rasm yuklash uchun Cloudinary (https://cloudinary.com)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# true bo‘lsa har bir foydalanuvchi fikr yoza oladi. Standart: faqat ADMIN_TELEGRAM_IDS (Fikrnoma nomidan).
OPEN_WRITING=false
